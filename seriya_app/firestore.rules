rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isApprovedAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedRole == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    match /users/{userId} {
      // Registration profiles are created only by the trusted Admin SDK
      // backend after the Text.lk OTP has been verified.
      allow create: if false;

      allow read: if ownsProfile(userId) || isApprovedAdmin();

      allow update: if isApprovedAdmin()
        || (ownsProfile(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fullName', 'email', 'updatedAt'])
          && request.resource.data.updatedAt == request.time);

      allow delete: if isApprovedAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
